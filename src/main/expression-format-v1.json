{
  "type": "json_schema",
  "json_schema": {
    "name": "grammatical_expression_suggestions",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expression": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "example": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "expression",
              "explanation",
              "example",
              "evidence_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "suggestions"
      ],
      "additionalProperties": false
    }
  }
}
